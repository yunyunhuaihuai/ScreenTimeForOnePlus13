<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 使用情况统计：AppOps 型特殊权限，由 root/appops 或设置页授予 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 包可见性：统计器需要看到所有应用（含已冻结/禁用的）的名称与状态 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 耗电快照采集备用通道：DUMP 是 signature|development 型权限，
         debug 构建可用 `adb shell pm grant com.local.screentime android.permission.DUMP`
         授予（无需 root）。root 正常时用不到。 -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".App"
        android:label="屏幕时间"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ScreenTime"
        android:allowBackup="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 插电瞬间抢拍：系统在充电开始时即重置 batterystats「自上次充电」窗口，
             接收器与系统抢跑，把重置前的最终累计值存进快照（v0.16.8）。
             POWER_CONNECTED 属隐式广播豁免清单，可静态注册，重启后依然有效。 -->
        <receiver
            android:name=".PowerEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
